{
  "name": "find-the-edge",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "boundaries": "node --test scripts/check-boundaries.test.mjs && node scripts/check-boundaries.mjs",
    "coverage": "pnpm --filter @find-the-edge/web coverage",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "synth": "pnpm --filter @find-the-edge/infra-cdk synth",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "typecheck:tools": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm typecheck:tools && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
