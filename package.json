{
  "name": "find-the-edge",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "turbo run build",
    "boundaries": "node --test scripts/check-boundaries.test.mjs && node scripts/check-boundaries.mjs",
    "coverage": "pnpm --filter @find-the-edge/web coverage",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:web-runtime-config": "node scripts/generate-web-runtime-config.mjs",
    "identity-authorization:provision": "node scripts/identity-authorization-provision.mjs",
    "ingestion-cost:baseline": "node scripts/ingestion-cost-attribution.mjs",
    "phase1:preflight": "node scripts/phase1-preflight.mjs",
    "phase1:bundle": "node scripts/build-phase1-web.mjs",
    "phase1:smoke": "node scripts/phase1-environment-smoke.mjs",
    "phase1:launch": "node scripts/phase1-launch.mjs",
    "phase1:reset-feed": "node scripts/phase1-reset-feed.mjs",
    "phase1:test": "node --test scripts/*phase1*.test.mjs scripts/cognito-token-provider.test.mjs scripts/environment-contract.test.mjs scripts/deployment-workflow.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "synth": "pnpm --filter @find-the-edge/infra-cdk synth",
    "test": "turbo run test",
    "test:identity-authorization-provision": "node --test scripts/identity-authorization-provision.test.mjs scripts/deployment-workflow.test.mjs scripts/phase1-reset-feed.test.mjs",
    "test:phase1-reset-feed": "node --test scripts/phase1-reset-feed.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "turbo run typecheck",
    "typecheck:tools": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm typecheck:tools && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
